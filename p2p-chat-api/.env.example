# Environment: development | production | testing
FLASK_ENV=development

# MANDATORY in production (minimum 32+ random bytes, e.g. python -c "import secrets; print(secrets.token_hex(32))")
P2P_SECRET_KEY=replace-with-a-strong-random-secret-key

# Optional PostgreSQL DSN. Leave blank to use SQLite WAL at P2P_DB_PATH
DATABASE_URL=

# SQLite database path (used when DATABASE_URL is empty)
P2P_DB_PATH=./data/p2p_chat.db

# Profile photo upload directory (stored outside static webroot)
P2P_UPLOAD_DIR=./uploads

# Redis connection string for distributed multi-worker rate limiting (falls back to memory:// in dev)
REDIS_URL=

# Structured log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
